# === SceneEcho environment ===
# Copy to .env and fill in your values. .env is gitignored.

# --- Storage ---
# All services read/write under this root (relative to repo root or absolute).
DATA_ROOT=backend/data

# --- Service URLs ---
RENDERER_URL=http://localhost:8001
BACKEND_URL=http://localhost:18521

# --- LLM / VLM (OpenAI-compatible endpoint, used from Phase 1+) ---
LLM_BASE_URL=https://api.ppio.com/openai/v1
LLM_API_KEY=sk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
MODEL_VLM=qwen/qwen3.6-plus
MODEL_TEXT=deepseek/deepseek-v4-pro
MODEL_TEXT_CHEAP=qwen/qwen3.6-plus
# --- LLM provider routing (Phase 0.5+) ---
# openai = OpenAI-compatible (Qwen-VL via DashScope, GPT-4o); anthropic = Claude native; mixed = route by stage
MODEL_PROVIDER=openai
ANTHROPIC_API_KEY=
# Comma-separated stage list; matching stages go through chat_vision_dual cross-check (Phase 1A+)
DUAL_CHECK_STAGES=

# --- BGM strategy: features (safe, default) | original (copyright risk) ---
BGM_STRATEGY=features

# --- AIGC B-roll 生成 (Phase 5) ---
# 留空禁用 AIGC，所有标「AI生成画面」的 slot 在 apply 阶段走 reuse 策略 fallback。
# 后端实际是「文本生图 + ffmpeg 把静图循环成 mp4」——视频侧的运动由模板的
# zoom_keyframes 在渲染时附加，生成 API 只产出静态画面。
# 配置 provider + api_key + model 后，apply 时勾选「允许 AI 补画面」才会真调第三方 API。
AIGC_BROLL_PROVIDER=
AIGC_BROLL_API_KEY=
AIGC_BROLL_BASE_URL=https://api.ppio.com/openai/v1/images/generations
# PPIO 图像生成模型 id（OpenAI-compat 接口），如 black-forest-labs/flux-1-schnell
# 或 stabilityai/stable-diffusion-3-5-large。留空禁用 AIGC（等同 PROVIDER 为空）。
AIGC_BROLL_MODEL=
# 静图循环成 mp4 的最长秒数；slot.duration.nominal 超过此值时截短到这里，
# 避免单条 AI 补画面占满 timeline（decisions/013 代价 2）。
AIGC_BROLL_MAX_DURATION_SEC=6.0

# --- ASR (Phase 2) ---
# 仅当 ASR_PROVIDER=whisperx（或 glm 路径降级到 whisperx 自闭环）时才生效；
# 默认 glm 路径用 PPIO 网络调用，不读这三项。
# Production default is large-v3 (PLAN 1593). Smaller variants for
# disk-constrained dev machines: tiny (~75MB) / base (~290MB) /
# small (~970MB) / medium (~1.5GB) / large-v3 (~3GB).
ASR_MODEL=large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8

# --- ASR provider (Phase 2 后端切换) ---
# glm     = GLM-ASR-2512 via PPIO gateway → 高精度中文文本，字级时间戳由
#           wav2vec2 forced alignment（whisperx 装了走 Leg A）或等比兜底
#           （whisperx 缺失走 Leg B）补齐——文本始终进入 ledger，
#           alignment 失败不再丢文本（decisions/014）。需 LLM_API_KEY 已配 PPIO key。
# whisperx = 全程跑本地 WhisperX（老路径，网络不可用 / 无 PPIO 凭据时的 fallback）。
ASR_PROVIDER=glm
ASR_BASE_URL=https://api.ppio.com/v3/glm-asr
MODEL_ASR=glm-asr-2512

# --- Unit segmentation (字幕切分阈值) ---
# 词间停顿 > UNIT_GAP_SEC 处断句；累积字数到 UNIT_MAX_CHARS 强制断；短于
# UNIT_MIN_CHARS 不断除非硬上限触发。0.15s + 4-12 字符合短视频「一停顿一字幕」
# 的常见审美。流畅口播中词间停顿基本 < 0.3s，所以原 0.3 阈值会把整段并成一条。
UNIT_GAP_SEC=0.15
UNIT_MAX_CHARS=12
UNIT_MIN_CHARS=4

# --- HuggingFace cache (Phase 2) ---
# DATA_ROOT-relative path; weights co-locate with kb.sqlite / system/...
# 设为绝对路径覆盖；设为空字符串恢复 HF 默认（~/.cache/huggingface）。
HF_CACHE_DIR=.cache/huggingface

# --- Dev-only: enables CLI ingest of arbitrary local paths ---
ENABLE_CLI_INGEST=true

# --- Dev-only: enables /api/dev/workbench/mock-stream and the /sublab routes ---
ENABLE_DEV_MOCK=true

# --- Logging level: DEBUG | INFO | WARNING | ERROR ---
LOG_LEVEL=INFO
