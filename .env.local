# === Dev-only overrides (gitignored) ===
# Wins over .env. Use this to point ASR to a small model so the HF
# cache stays under a few hundred MB and the recommend endpoint
# completes in seconds even on disk-constrained machines.
#
# Disk math for a 15s 口播 clip:
#   ASR_MODEL=tiny    → ~75MB  (verification-only, sync precision ~200ms)
#   ASR_MODEL=base    → ~290MB (PLAN 1654 < 0.15s typically met)
#   ASR_MODEL=small   → ~970MB (recommended dev default)
#   ASR_MODEL=medium  → ~1.5GB
#   ASR_MODEL=large-v3 → ~3GB  (production default, kept in .env)
#
# WhisperX additionally pulls the wav2vec2-large-xlsr-53-chinese
# alignment model (~1.2GB on first call regardless of asr_model size).

ASR_MODEL=small
